# Copy to .env and fill in. Never commit .env.

# Comma separated list of API keys clients must send in the X-API-Key header.
GA_API_KEYS=dev-key

# "fake" runs offline with a deterministic extractive model. "openai" calls any
# OpenAI-compatible chat completions endpoint (OpenAI, a gateway, or a local server).
GA_LLM_PROVIDER=fake
GA_LLM_BASE_URL=https://api.openai.com/v1
GA_LLM_API_KEY=
GA_LLM_MODEL=
# Local example (Ollama, vLLM, llama.cpp server):
# GA_LLM_BASE_URL=http://localhost:11434/v1
# GA_LLM_MODEL=qwen2.5:7b-instruct

# Retrieval and guardrails.
GA_DOCS_DIR=data/docs
GA_TOP_K=4
GA_MIN_RETRIEVAL_SCORE=3.0
GA_MAX_QUESTION_CHARS=500
GA_RATE_LIMIT_PER_MINUTE=30
